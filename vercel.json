{
    "version": 2,
    "framework": "create-react-app",
    "buildCommand": "CI=false npm run build",
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "https://hrmis-api.devfamz.com/api/$1"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}